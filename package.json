{
  "name": "acervo-acervos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coleção de Acervos Digitais — Coleções online de arquivos comunitários do Brasil e da América Latina.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check-data.mjs && astro check",
    "check:data": "node scripts/check-data.mjs",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "validate": "pnpm check && pnpm build && pnpm test:e2e",
    "review": "node scripts/review.mjs",
    "export": "node scripts/export.mjs",
    "register": "node scripts/asset-register.mjs",
    "og": "node scripts/make-og.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "lighthouse": "^13.6.0",
    "typescript": ">=5.9 <7"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
