{
  "name": "acervo-acervos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Acervo Acervos — Explore o que iniciativas e arquivos compartilham online.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check-data.mjs && astro sync",
    "check:data": "node scripts/check-data.mjs",
    "review": "node scripts/review.mjs",
    "export": "node scripts/export.mjs",
    "og": "node scripts/make-og.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current", "linux"],
      "cpu": ["current", "arm64"],
      "libc": ["glibc"]
    },
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
