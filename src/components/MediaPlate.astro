---
/**
 * Prancha de mídia de um registro.
 *
 * - Com imagem licenciada (`media`): a imagem é a protagonista, na proporção
 *   original, sem recorte; legenda, crédito e licença logo abaixo.
 * - Sem imagem: prancha tipográfica honesta com o título da amostra, o tipo
 *   de mídia observado e o motivo de não haver imagem. Nunca uma capa inventada.
 */
import { Picture } from 'astro:assets';
import * as V from '../data/vocabulario';
import type { Acervo } from '../lib/acervos';

interface Props {
  record: Acervo;
  /** list: índice de exploração · detail: página do registro · feature: destaque da home */
  variant?: 'list' | 'detail' | 'feature';
  eager?: boolean;
}
const { record: r, variant = 'list', eager = false } = Astro.props;
const m = [...r.media].sort((a, b) => a.order - b.order)[0];

const sizes = {
  list: '(min-width: 60rem) 22rem, (min-width: 40rem) 40vw, 92vw',
  feature: '(min-width: 60rem) 30rem, 92vw',
  detail: '(min-width: 60rem) 36rem, 92vw',
}[variant];

const widths = m
  ? [...new Set([320, 480, 640, 960, 1280].filter((w) => w < m.local_asset.width).concat(m.local_asset.width))]
  : [];
const mediaKinds = r.sample.confirmed_media.length ? r.sample.confirmed_media : r.formats;
---
{m ? (
  <figure class={`plate plate--image plate--${variant}`}>
    <Picture
      src={m.local_asset}
      alt={m.alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    <figcaption class="meta">
      {m.caption && <span class="cap">{m.caption}</span>}
      <span>{m.credit}</span>
      <span>
        {m.license_url ? (
          <a href={m.license_url} rel="noopener noreferrer external">{m.license_or_permission}</a>
        ) : (
          m.license_or_permission
        )}
        {' · '}
        <a href={m.page_url} rel="noopener noreferrer external" class="ext">fonte</a>
      </span>
      {variant === 'detail' && (
        <>
          <span class="muted">
            Descrição da imagem {m.alt_source === 'fonte' ? 'fornecida pela fonte' : 'escrita pela curadoria a partir do que é visível'}.
          </span>
          <a href={m.local_asset.src} class="zoom">
            Ver imagem inteira ({m.local_asset.width} × {m.local_asset.height} px, tamanho publicado pela fonte)
          </a>
        </>
      )}
    </figcaption>
  </figure>
) : (
  <div class={`plate plate--type plate--${variant}`}>
    <p class="pt-kind">{mediaKinds.map((f) => V.label(V.formats, f)).join(' · ')}</p>
    <p class="pt-title">{r.sample.title}</p>
    <p class="pt-note">{r.media_note ?? 'Sem imagem com direito de exibição confirmado.'}</p>
    <a href={r.sample_content_url} rel="noopener noreferrer external" class="ext pt-link">
      Ver a amostra na fonte<span class="visually-hidden">: {r.sample.title}</span>
    </a>
  </div>
)}

<style>
  .plate {
    margin: 0;
  }
  .plate--image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* proporção original preservada; nada de recorte */
    object-fit: contain;
    background: var(--paper-2);
  }
  .plate--list :global(img) {
    max-height: 32rem;
    width: auto;
    max-width: 100%;
  }
  .plate--detail :global(img) {
    max-height: 85vh;
    width: auto;
    max-width: 100%;
  }
  .plate--feature :global(img) {
    max-height: 70vh;
    width: auto;
    max-width: 100%;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.5rem;
    color: var(--muted);
  }
  figcaption .cap {
    color: var(--ink);
  }
  .zoom {
    margin-top: 0.3rem;
  }

  .plate--type {
    border: 1.5px solid var(--ink);
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 14rem;
    background:
      repeating-linear-gradient(0deg, transparent 0 1.55rem, rgb(28 26 23 / 0.06) 1.55rem calc(1.55rem + 1px)),
      var(--paper);
  }
  .plate--detail.plate--type {
    min-height: 20rem;
  }
  .pt-kind {
    font-family: var(--f-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--blue);
    margin: 0;
  }
  .pt-title {
    font-family: var(--f-display);
    font-stretch: condensed;
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.05;
    margin: 0;
    flex: 1;
  }
  .plate--list .pt-title {
    font-size: var(--step-1);
  }
  .pt-note {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0;
  }
  .pt-link {
    font-size: var(--step--1);
  }
</style>
