---
import { sitePath } from '../lib/site-path';
import { siteConfig } from '../site.config';
import { getAll, lastUpdate, formatDate } from '../lib/acervos';
const updated = lastUpdate(await getAll());
---
<footer class="site-footer">
  <div class="wrap foot">
    <p class="foot-name">
      <strong>{siteConfig.name}</strong> ·
      Um projeto do <a href={siteConfig.viveiro.url} rel="noopener noreferrer external">{siteConfig.viveiro.name}</a>
    </p>
    <ul class="foot-links">
      <li><a href={sitePath('/sobre/')}>Sobre</a></li>
      <li><a href={sitePath('/metodologia/')}>Metodologia</a></li>
      <li>{siteConfig.contactUrl ? <a href={siteConfig.contactUrl} rel="noopener noreferrer external">Corrigir ou sugerir</a> : <a href={sitePath('/sobre/#corrigir')}>Corrigir ou sugerir</a>}</li>
      {siteConfig.repoUrl && <li><a href={siteConfig.repoUrl} rel="noopener noreferrer external">Código e dados</a></li>}
    </ul>
    <p class="meta muted foot-rights">
      Imagens de terceiros só aparecem com licença declarada pela fonte, com crédito em cada registro; as
      obras continuam nas iniciativas de origem. Atualizado em <time datetime={updated}>{formatDate(updated)}</time>.
    </p>
  </div>
</footer>
<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .foot-name {
    margin: 0;
  }
  .foot-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.2rem;
    margin: 0;
    padding: 0;
  }
  .foot-rights {
    flex-basis: 100%;
    margin: 0.4rem 0 0;
    max-width: none;
  }
</style>
