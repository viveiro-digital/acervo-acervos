---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Trilha" class="crumbs meta">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.3rem; padding: 0; margin: 0 0 0.8rem; }
  .crumbs li + li::before { content: '/'; margin-right: 0.3rem; color: var(--muted); }
</style>
