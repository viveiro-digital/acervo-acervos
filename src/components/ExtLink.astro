---
/** Link externo: abre na mesma aba por padrão (sem target), com rel seguro. */
interface Props { href: string; class?: string; label?: string; newTab?: boolean }
const { href, class: cls = '', label, newTab = false } = Astro.props;
---
<a href={href} class={`ext ${cls}`} rel="noopener noreferrer external" target={newTab ? '_blank' : undefined} aria-label={label}><slot /></a>
