---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import CollectionCover from '../components/CollectionCover.astro';
import ExtLink from '../components/ExtLink.astro';
import * as V from '../data/vocabulario';
import { getPublished, recordPath } from '../lib/acervos';

const records = await getPublished();

const rows: { label: string; cell: (r: (typeof records)[number]) => string }[] = [
  { label: 'O que tem', cell: (r) => r.description.pt },
  { label: 'Lugar', cell: (r) => [r.city, r.region, ...r.country.map((c) => V.label(V.countries, c))].filter(Boolean).join(', ') },
  { label: 'Período', cell: (r) => r.date_range.label },
  { label: 'Acesso', cell: (r) => V.label(V.accessLevels, r.access_level) },
];
---
<Base
  title="Comparar"
  description="Veja o que cada coleção reúne e abra o acervo de origem."
  current="comparar"
>
  <div class="wrap">
    <header>
      <h1>Comparar</h1>
    </header>

    <form id="escolha" class="pick" action={sitePath('/comparar/')} method="get">
      <details class="picker">
        <summary>Escolher acervos</summary>
        <fieldset>
          <legend class="visually-hidden">Acervos</legend>
        <ul class="pick-list">
          {records.map((r) => (
            <li>
              <label><input type="checkbox" name="id" value={r.id} /> {r.name}</label>
            </li>
          ))}
        </ul>
        </fieldset>
      </details>
      <p id="aviso" class="meta" role="status" aria-live="polite"></p>
      <noscript>
        <p class="callout meta">
          A seleção precisa de JavaScript. Sem ele, a tabela abaixo mostra todos os registros;
          role horizontalmente para ver as colunas.
        </p>
      </noscript>
    </form>

    <div class="table-wrap" tabindex="0" role="region" aria-label="Tabela de comparação">
      <table id="tabela">
        <caption class="visually-hidden">Comparação de registros selecionados</caption>
        <thead>
          <tr>
            <td></td>
            {records.map((r) => (
              <th scope="col" data-col={r.id}>
                <CollectionCover id={r.id} name={r.name} />
                <a href={recordPath(r.id)}>{r.name}</a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {records.map((r) => <td data-col={r.id}>{row.cell(r)}</td>)}
            </tr>
          ))}
          <tr>
            <th scope="row">Coleção</th>
            {records.map((r) => <td data-col={r.id}><ExtLink href={r.digital_collection_url}>Explorar a coleção</ExtLink></td>)}
          </tr>
        </tbody>
      </table>
    </div>
    <p id="vazio" class="callout" hidden>Escolha de 2 a 4 acervos.</p>
  </div>
</Base>

<script>
  const MAX = 4;
  const form = document.getElementById('escolha') as HTMLFormElement;
  const boxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="id"]'));
  const table = document.getElementById('tabela') as HTMLTableElement;
  const empty = document.getElementById('vazio')!;
  const aviso = document.getElementById('aviso')!;
  const valid = new Set(boxes.map((b) => b.value));

  function fromUrl(): string[] {
    const raw = new URLSearchParams(location.search).get('ids') ?? '';
    return raw.split(',').filter((id) => valid.has(id)).slice(0, MAX);
  }

  function render(ids: string[]) {
    for (const b of boxes) {
      b.checked = ids.includes(b.value);
      b.disabled = !b.checked && ids.length >= MAX;
    }
    const show = ids.length >= 2;
    table.closest('.table-wrap')!.toggleAttribute('hidden', !show);
    empty.hidden = show;
    for (const cell of table.querySelectorAll<HTMLElement>('[data-col]')) {
      cell.hidden = !ids.includes(cell.dataset.col!);
    }
    // ordem das colunas segue a ordem da seleção
    for (const tr of table.rows) {
      for (const id of ids) {
        const c = tr.querySelector(`[data-col="${id}"]`);
        if (c) tr.appendChild(c);
      }
    }
    aviso.textContent =
      ids.length ? `${ids.length} de ${MAX} acervos` : '';
    const qs = ids.length ? `?ids=${ids.join(',')}` : '';
    history.replaceState(null, '', location.pathname + qs);
  }

  let current = fromUrl();
  render(current);
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.checked) current = [...current, t.value].slice(0, MAX);
    else current = current.filter((id) => id !== t.value);
    render(current);
  });
  form.addEventListener('submit', (e) => e.preventDefault());
</script>

<style>
  thead :global(.collection-cover) { aspect-ratio: 3 / 2; margin-bottom: 0.6rem; }
  .picker summary { cursor: pointer; width: fit-content; padding-block: 0.55rem; }
  .picker fieldset { padding-block: 0.65rem; }
  .pick-list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 16rem;
    column-gap: 2rem;
  }
  .pick-list li {
    break-inside: avoid;
    padding: 0.2rem 0;
  }
  .pick-list input {
    width: 1.1rem;
    height: 1.1rem;
    vertical-align: -0.15rem;
  }
  .table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--rule);
    margin-top: 1rem;
  }
  .table-wrap table {
    min-width: 40rem;
  }
  thead th {
    font-family: var(--f-display);
    font-stretch: condensed;
    font-size: var(--step-1);
    min-width: 13rem;
  }
</style>
