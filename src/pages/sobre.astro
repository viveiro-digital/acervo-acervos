---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import ExtLink from '../components/ExtLink.astro';
import { siteConfig } from '../site.config';
---
<Base
  title="Sobre"
  description="O que Acervo Acervos seleciona, como verifica, o que não é, suas limitações e como corrigir um registro. Um projeto do Viveiro Digital."
  current="sobre"
>
  <div class="wrap narrow">
    <h1>Sobre</h1>
    <p class="lede">
      Uma seleção de arquivos e iniciativas do Brasil e da América Latina. Explore zines,
      cartazes, fotografias e outros materiais nas coleções de origem.
    </p>
    <p>
      Um projeto do <ExtLink href={siteConfig.viveiro.url}>{siteConfig.viveiro.name}</ExtLink>.
      <a href={sitePath('/metodologia/')}>Conheça a metodologia</a>.
    </p>
    <h2 id="corrigir">Corrigir um registro</h2>
    <p>
      Iniciativas podem contestar ou corrigir como são descritas, e pedidos de remoção têm
      prioridade.{' '}
      {siteConfig.contactUrl ? (
        <ExtLink href={siteConfig.contactUrl}>Abra uma issue no repositório</ExtLink>
      ) : (
        'O canal público ainda não foi publicado.'
      )}{' '}
      ou veja <a href={sitePath('/contribuir/')}>como contribuir</a>.
    </p>
  </div>
</Base>
<style>
  .narrow { max-width: 78rem; }
  .lede { font-size: var(--step-1); line-height: 1.4; }
  h2 { margin-top: 2rem; }
</style>
