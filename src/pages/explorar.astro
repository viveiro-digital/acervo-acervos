---
import { sitePath } from '../lib/site-path';

const home = sitePath('/');
const canonical = new URL(home, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <title>Acervo Acervos</title>
    <script is:inline define:vars={{ home }}>
      location.replace(home + location.search + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${home}`} /></noscript>
  </head>
  <body><a href={home}>Buscar no Acervo Acervos</a></body>
</html>
