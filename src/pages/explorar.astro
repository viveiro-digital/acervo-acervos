---
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import MediaPlate from '../components/MediaPlate.astro';
import * as V from '../data/vocabulario';
import {
  getPublished,
  facetCounts,
  periodBuckets,
  periodKeys,
  searchText,
  normalize,
  formatDate,
  recordPath,
} from '../lib/acervos';

const records = await getPublished();

type Facet = {
  param: string;
  legend: string;
  vocab: Record<string, string>;
  pick: (r: (typeof records)[number]) => string[];
  note?: string;
};

const periodVocab = Object.fromEntries(periodBuckets.map((b) => [b.key, b.label]));

const facets: Facet[] = [
  { param: 'pais', legend: 'País / região', vocab: V.countries, pick: (r) => r.country },
  { param: 'tema', legend: 'Tema', vocab: V.themes, pick: (r) => r.themes },
  { param: 'tipo', legend: 'Tipo de acervo', vocab: V.collectionTypes, pick: (r) => r.collection_types },
  { param: 'formato', legend: 'Formato', vocab: V.formats, pick: (r) => r.formats },
  { param: 'lingua', legend: 'Língua', vocab: V.languages, pick: (r) => r.languages },
  { param: 'periodo', legend: 'Período do conteúdo', vocab: periodVocab, pick: (r) => periodKeys(r) },
  { param: 'acesso', legend: 'Regime de acesso', vocab: V.accessLevels, pick: (r) => [r.access_level] },
  { param: 'status', legend: 'Verificação', vocab: V.contentStatuses, pick: (r) => [r.content_status] },
  {
    param: 'relacao',
    legend: 'Relação comunitária',
    vocab: V.communityEvidenceKinds,
    pick: (r) => [r.community_evidence.kind],
    note: 'Segundo a evidência publicada — não é avaliação de governança.',
  },
  { param: 'host', legend: 'Quem mantém', vocab: V.stewardshipTypes, pick: (r) => [r.stewardship_or_host.type] },
];

const facetOptions = facets.map((f) => {
  const counts = facetCounts(records, f.pick);
  const options = Object.keys(f.vocab)
    .filter((k) => counts.has(k))
    .map((k) => ({ key: k, label: f.vocab[k], count: counts.get(k)! }));
  return { ...f, options };
});
---
<Base
  title="Explorar"
  description="Filtre iniciativas e arquivos por território, tema, tipo de acervo, formato, língua, período, acesso e verificação."
  current="explorar"
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">Índice</p>
      <h1>Explorar</h1>
      <p>
        Todos os registros publicados estão nesta página. Os filtros podem ser combinados e ficam
        no endereço, então dá para copiar e compartilhar uma busca. Os filtros descrevem o que foi
        verificado, não a qualidade das iniciativas.
      </p>
    </header>

    <div class="layout">
      <form id="filtros" class="filters" action="/explorar/" method="get" role="search" aria-label="Filtros do índice">
        <div class="field">
          <label for="q" class="kicker">Busca textual</label>
          <input id="q" name="q" type="search" placeholder="nome, tema, lugar…" autocomplete="off" />
        </div>
        <div class="field">
          <label for="ordem" class="kicker">Ordenar por</label>
          <select id="ordem" name="ordem">
            <option value="">Padrão</option>
            <option value="nome">Nome (A–Z)</option>
            <option value="atualizacao">Atualização mais recente</option>
            <option value="inclusao">Inclusão mais recente</option>
            <option value="relevancia">Correspondência com a busca</option>
          </select>
          <p class="meta muted hint">Padrão: nome; com busca, correspondência.</p>
        </div>
        {facetOptions.map((f) => (
          <div class="field">
            <label for={`f-${f.param}`} class="kicker">{f.legend}</label>
            <select id={`f-${f.param}`} name={f.param} data-facet={f.param}>
              <option value="">Todos</option>
              {f.options.map((o) => (
                <option value={o.key}>{o.label} ({o.count})</option>
              ))}
            </select>
            {f.note && <p class="meta muted hint">{f.note}</p>}
          </div>
        ))}
        <div class="actions">
          <button class="btn btn--primary" type="submit">Aplicar</button>
          <a class="btn" href="/explorar/" id="limpar">Limpar</a>
        </div>
        <noscript>
          <p class="callout meta">
            Os filtros precisam de JavaScript. Sem ele, a lista abaixo mostra todos os registros
            publicados.
          </p>
        </noscript>
      </form>

      <section aria-labelledby="resultados-titulo">
        <h2 id="resultados-titulo" class="visually-hidden">Resultados</h2>
        <div id="chips" class="chips" aria-label="Filtros ativos"></div>
        <p id="contagem" class="meta" role="status" aria-live="polite">
          {records.length} registros publicados.
        </p>
        <p id="vazio" class="callout" hidden>
          Nenhum registro corresponde a essa combinação. Isso não significa que a iniciativa não
          exista — talvez ainda não tenha sido verificada. Remova um filtro acima ou{' '}
          <a href="/contribuir/">sugira uma iniciativa</a>.
        </p>

        <ol class="vindex" id="lista">
          {records.map((r, i) => (
            <li
              data-id={r.id}
              data-name={r.name}
              data-updated={r.updated_at}
              data-created={r.created_at}
              data-search={searchText(r)}
              data-name-norm={normalize([r.name, r.preferred_name ?? '', ...r.alternative_names].join(' '))}
              {...Object.fromEntries(facets.map((f) => [`data-${f.param}`, f.pick(r).join(' ')]))}
            >
              <div class="entry-media">
                <MediaPlate record={r} variant="list" eager={i < 2} />
              </div>
              <div class="entry-text">
                <p class="kicker">
                  {r.country.map((c) => V.label(V.countries, c)).join(' · ')}
                  {r.city && ` — ${r.city}`} · {V.label(V.initiativeTypes, r.initiative_type)}
                </p>
                <h3><a href={recordPath(r.id)} data-open={r.id}>{r.name}</a></h3>
                <p>{r.description.pt}</p>
                <ul class="tags" aria-label="Temas">
                  {r.themes.map((t) => <li>{V.label(V.themes, t)}</li>)}
                </ul>
                <p class="meta entry-status">
                  <Status status={r.content_status} />
                  <span>Acesso: {V.label(V.accessLevels, r.access_level)}</span>
                  <span>Mantém: {V.label(V.stewardshipTypes, r.stewardship_or_host.type)}</span>
                  <span>Verificado em <time datetime={r.last_verified_at}>{formatDate(r.last_verified_at)}</time></span>
                </p>
              </div>
            </li>
          ))}
        </ol>
        <p class="meta muted">
          Registros em revisão (sem amostra confirmada) não aparecem aqui; estão listados em{' '}
          <a href="/metodologia/#pendentes">Metodologia › Pendentes</a>.
        </p>
      </section>
    </div>
  </div>

  <dialog id="painel" class="panel" aria-labelledby="painel-titulo">
    <div class="panel-bar">
      <button type="button" class="btn" data-panel="prev" aria-label="Registro anterior nos resultados">←</button>
      <span class="meta" id="painel-pos" aria-live="polite"></span>
      <button type="button" class="btn" data-panel="next" aria-label="Próximo registro nos resultados">→</button>
      <a class="meta panel-page" id="painel-link" href="/explorar/">Página do registro</a>
      <button type="button" class="btn" data-panel="close">Fechar <span class="visually-hidden">painel</span>(Esc)</button>
    </div>
    <div id="painel-corpo" class="panel-body"></div>
  </dialog>
</Base>

<script>
  const PARAMS = ['q', 'ordem', 'pais', 'tema', 'tipo', 'formato', 'lingua', 'periodo', 'acesso', 'status', 'relacao', 'host'];
  const FACETS = PARAMS.filter((p) => p !== 'q' && p !== 'ordem');

  const form = document.getElementById('filtros') as HTMLFormElement;
  const list = document.getElementById('lista') as HTMLOListElement;
  const items = Array.from(list.querySelectorAll<HTMLLIElement>(':scope > li'));
  const count = document.getElementById('contagem')!;
  const empty = document.getElementById('vazio')!;
  const chips = document.getElementById('chips')!;

  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

  function readUrl() {
    const u = new URLSearchParams(location.search);
    for (const p of PARAMS) {
      const el = form.elements.namedItem(p) as HTMLInputElement | HTMLSelectElement | null;
      if (!el) continue;
      const v = u.get(p) ?? '';
      if (el instanceof HTMLSelectElement && v && !Array.from(el.options).some((o) => o.value === v)) {
        el.value = '';
      } else {
        el.value = v;
      }
    }
  }

  function state() {
    const s: Record<string, string> = {};
    for (const p of PARAMS) {
      const el = form.elements.namedItem(p) as HTMLInputElement | HTMLSelectElement | null;
      if (el && el.value.trim()) s[p] = el.value.trim();
    }
    return s;
  }

  function writeUrl(s: Record<string, string>) {
    const u = new URLSearchParams();
    // ordem determinística dos parâmetros
    for (const p of PARAMS) if (s[p]) u.set(p, s[p]);
    const qs = u.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function score(li: HTMLLIElement, terms: string[]) {
    const all = li.dataset.search ?? '';
    const name = li.dataset.nameNorm ?? '';
    let sc = 0;
    for (const t of terms) {
      if (!all.includes(t)) return -1;
      sc += name.includes(t) ? 3 : 1;
    }
    return sc;
  }

  function apply() {
    const s = state();
    const terms = s.q ? norm(s.q).split(/\s+/).filter(Boolean) : [];
    const scored: [HTMLLIElement, number][] = [];
    for (const li of items) {
      let ok = true;
      for (const f of FACETS) {
        if (s[f] && !(li.dataset[f] ?? '').split(' ').includes(s[f])) ok = false;
      }
      const sc = terms.length ? score(li, terms) : 0;
      if (sc < 0) ok = false;
      li.hidden = !ok;
      if (ok) scored.push([li, sc]);
    }
    const ordem = s.ordem ?? (s.q ? 'relevancia' : 'nome');
    const byName = (a: HTMLLIElement, b: HTMLLIElement) => (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'pt');
    const sorted = [...items].sort((a, b) => {
      if (ordem === 'atualizacao') return (b.dataset.updated ?? '').localeCompare(a.dataset.updated ?? '') || byName(a, b);
      if (ordem === 'inclusao') return (b.dataset.created ?? '').localeCompare(a.dataset.created ?? '') || byName(a, b);
      if (ordem === 'relevancia') {
        const sa = scored.find(([li]) => li === a)?.[1] ?? -1;
        const sb = scored.find(([li]) => li === b)?.[1] ?? -1;
        return sb - sa || byName(a, b);
      }
      return byName(a, b);
    });
    let n = 0;
    for (const li of sorted) {
      list.appendChild(li);
      if (!li.hidden) n++;
    }
    const total = items.length;
    count.textContent = n === total ? `${total} registros publicados.` : `${n} de ${total} registros correspondem aos filtros.`;
    empty.hidden = n !== 0;
    renderChips(s);
    writeUrl(s);
  }

  let lastChips = '';
  function renderChips(s: Record<string, string>) {
    // Não recria os botões se nada mudou: um "change" disparado pelo blur da
    // busca no meio de um clique apagaria o botão clicado.
    const sig = JSON.stringify(PARAMS.filter((p) => p !== 'ordem').map((p) => s[p] ?? ''));
    if (sig === lastChips) return;
    lastChips = sig;
    chips.replaceChildren();
    for (const p of PARAMS) {
      if (p === 'ordem' || !s[p]) continue;
      const el = form.elements.namedItem(p) as HTMLInputElement | HTMLSelectElement;
      const labelEl = form.querySelector(`label[for="${el.id}"]`);
      const valueLabel = el instanceof HTMLSelectElement ? el.selectedOptions[0]?.textContent?.replace(/\s*\(\d+\)$/, '') : `“${s[p]}”`;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip';
      b.textContent = `${labelEl?.textContent ?? p}: ${valueLabel} ✕`;
      b.setAttribute('aria-label', `Remover filtro ${labelEl?.textContent ?? p}: ${valueLabel}`);
      b.addEventListener('click', () => {
        el.value = '';
        apply();
        (form.elements.namedItem('q') as HTMLInputElement).focus();
      });
      chips.appendChild(b);
    }
  }

  readUrl();
  apply();
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    apply();
  });
  form.addEventListener('change', apply);
  let t: number | undefined;
  (form.elements.namedItem('q') as HTMLInputElement).addEventListener('input', () => {
    clearTimeout(t);
    t = window.setTimeout(apply, 200);
  });
  document.getElementById('limpar')!.addEventListener('click', (e) => {
    e.preventDefault();
    form.reset();
    for (const p of PARAMS) {
      const el = form.elements.namedItem(p) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = '';
    }
    apply();
  });
  window.addEventListener('popstate', (e) => {
    if (e.state?.panel) return; // tratado pelo painel
    readUrl();
    apply();
  });


  // ── Painel contextual ───────────────────────────────────────────────
  // Aprimoramento progressivo: sem JS, o link abre a página canônica do
  // registro. Com JS, a mesma página é carregada num <dialog> nativo (foco
  // preso, Esc), a URL vira a do registro (link copiável; voltar fecha o
  // painel) e a lista mantém filtros e rolagem.
  const dialog = document.getElementById('painel') as HTMLDialogElement;
  const panelBody = document.getElementById('painel-corpo')!;
  const panelPos = document.getElementById('painel-pos')!;
  const panelLink = document.getElementById('painel-link') as HTMLAnchorElement;
  const prevBtn = dialog.querySelector('[data-panel="prev"]') as HTMLButtonElement;
  const nextBtn = dialog.querySelector('[data-panel="next"]') as HTMLButtonElement;
  const listTitle = document.title;
  const cache = new Map<string, string>();
  let currentId: string | null = null;
  let opener: HTMLElement | null = null;

  const visibleIds = () => items.filter((li) => !li.hidden).map((li) => li.dataset.id!);

  async function fetchRecord(id: string): Promise<string> {
    if (cache.has(id)) return cache.get(id)!;
    const res = await fetch(`/acervos/${id}/`);
    if (!res.ok) throw new Error(String(res.status));
    const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
    const art = doc.querySelector('article[data-record]');
    if (!art) throw new Error('sem conteúdo');
    const h1 = art.querySelector('h1');
    if (h1) {
      const h2 = doc.createElement('h2');
      h2.innerHTML = h1.innerHTML;
      h2.id = 'painel-titulo';
      h2.tabIndex = -1;
      h2.className = h1.className;
      h1.replaceWith(h2);
    }
    const html = art.outerHTML;
    cache.set(id, html);
    return html;
  }

  async function openPanel(id: string, mode: 'push' | 'replace' | 'none') {
    currentId = id;
    const url = `/acervos/${id}/`;
    panelLink.href = url;
    if (!dialog.open) {
      document.documentElement.classList.add('panel-open');
      dialog.showModal();
    }
    panelBody.setAttribute('aria-busy', 'true');
    panelBody.innerHTML = '<p class="meta panel-loading">Carregando registro…</p>';
    if (mode === 'push') history.pushState({ panel: id }, '', url);
    if (mode === 'replace') history.replaceState({ panel: id }, '', url);
    const ids = visibleIds();
    const pos = ids.indexOf(id);
    panelPos.textContent = pos >= 0 ? `${pos + 1} de ${ids.length} nos resultados` : '';
    prevBtn.disabled = pos <= 0;
    nextBtn.disabled = pos < 0 || pos >= ids.length - 1;
    try {
      panelBody.innerHTML = await fetchRecord(id);
      const title = panelBody.querySelector('#painel-titulo') as HTMLElement | null;
      document.title = `${title?.textContent ?? id} — Acervo Acervos`;
      title?.focus();
    } catch {
      panelBody.innerHTML = `<p class="callout">Não foi possível carregar o registro aqui. <a href="${url}">Abrir a página do registro</a>.</p>`;
    } finally {
      panelBody.removeAttribute('aria-busy');
      panelBody.scrollTop = 0;
    }
  }

  function requestClose() {
    if (history.state?.panel) history.back();
    else dialog.close();
  }

  dialog.addEventListener('close', () => {
    document.documentElement.classList.remove('panel-open');
    document.title = listTitle;
    currentId = null;
    opener?.focus();
  });
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault(); // Esc: fecha pelo histórico, para manter voltar/avançar coerentes
    requestClose();
  });
  dialog.querySelector('[data-panel="close"]')!.addEventListener('click', requestClose);
  // clique no fundo escurecido fecha
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) requestClose();
  });
  function step(delta: number) {
    const ids = visibleIds();
    const next = ids[ids.indexOf(currentId!) + delta];
    if (next) {
      opener = items.find((li) => li.dataset.id === next)?.querySelector('a[data-open]') ?? opener;
      openPanel(next, 'replace');
    }
  }
  prevBtn.addEventListener('click', () => step(-1));
  nextBtn.addEventListener('click', () => step(1));

  list.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[data-open]') as HTMLAnchorElement | null;
    if (!a) return;
    const me = e as MouseEvent;
    if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return; // nova aba etc.
    if (typeof dialog.showModal !== 'function') return; // navegador sem <dialog>: segue o link
    e.preventDefault();
    opener = a;
    openPanel(a.dataset.open!, 'push');
  });

  window.addEventListener('popstate', (e) => {
    if (e.state?.panel) openPanel(e.state.panel, 'none');
    else if (dialog.open) dialog.close();
  });
</script>

<style>
  .page-head {
    margin-bottom: 1.5rem;
  }
  .layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: start;
    }
    .filters {
      position: sticky;
      top: 1rem;
      max-height: calc(100vh - 2rem);
      overflow: auto;
      padding-right: 0.5rem;
    }
  }
  .field {
    margin-bottom: 0.9rem;
    display: grid;
    gap: 0.2rem;
  }
  .field select,
  .field input {
    width: 100%;
  }
  .hint {
    margin: 0;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .chips:empty {
    display: none;
  }
  /* Índice visual: imagem (ou prancha tipográfica) primeiro, texto depois */
  .vindex {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .vindex > li {
    display: grid;
    gap: 1rem 1.8rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 40rem) {
    .vindex > li {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
    }
  }
  .entry-text h3 {
    font-size: var(--step-2);
    margin: 0 0 0.4rem;
  }
  .entry-text h3 a {
    text-decoration: none;
  }
  .entry-text h3 a:hover,
  .entry-text h3 a:focus-visible {
    text-decoration: underline;
  }
  .entry-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    align-items: center;
    margin-top: 0.8rem;
    color: var(--muted);
  }

  /* Painel contextual */
  .panel {
    border: 0;
    padding: 0;
    margin: 0 0 0 auto;
    width: min(100vw, 62rem);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    background: var(--paper);
    color: var(--ink);
    box-shadow: -1px 0 0 var(--rule);
  }
  .panel::backdrop {
    background: rgb(28 26 23 / 0.45);
  }
  .panel-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    padding: 0.6rem 1rem;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .panel-bar [data-panel='close'] {
    margin-left: auto;
  }
  .panel-bar button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .panel-body {
    padding: 1.2rem 1rem 3rem;
  }
  .panel-body :global(.record) {
    width: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .panel[open] {
      animation: slide-in 0.18s ease-out;
    }
    @keyframes slide-in {
      from { transform: translateX(2rem); opacity: 0; }
      to { transform: none; opacity: 1; }
    }
  }
</style>
