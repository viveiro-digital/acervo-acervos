---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import CollectionCover from '../components/CollectionCover.astro';
import { siteConfig } from '../site.config';
import { collectionSubtitles, collectionViews } from '../data/collection-views';
import * as V from '../data/vocabulario';
import {
  getPublished,
  facetCounts,
  periodBuckets,
  periodKeys,
  searchFields,
  recordPath,
} from '../lib/acervos';

const published = await getPublished();
const order = [
  'museu-maguta', 'museu-da-mare', 'zumvi', 'potencia-tortillera', 'lesvoz',
  'acervo-bajuba', 'diseno-nacional', 'biblioteca-de-zines',
  'casca', 'irohin', 'archivo-memoria-trans', 'museu-kuahi', 'cartel-mexico',
];
const sorted = [
  ...order.flatMap((id) => published.filter((record) => record.id === id)),
  ...published.filter((record) => !order.includes(record.id)),
];
const shortNames: Record<string, string> = {
  'diseno-nacional': 'Diseño Nacional',
  irohin: 'Ìrohìn',
};


type Facet = {
  param: string;
  legend: string;
  vocab: Record<string, string>;
  pick: (r: (typeof published)[number]) => string[];
  note?: string;
};

const periodVocab = Object.fromEntries(periodBuckets.map((b) => [b.key, b.label]));

const facets: Facet[] = [
  { param: 'pais', legend: 'País / região', vocab: V.countries, pick: (r) => r.country },
  { param: 'tema', legend: 'Tema', vocab: V.themes, pick: (r) => r.themes },
  { param: 'tipo', legend: 'Tipo de acervo', vocab: V.collectionTypes, pick: (r) => r.collection_types },
  { param: 'formato', legend: 'Formato', vocab: V.formats, pick: (r) => r.formats },
  { param: 'lingua', legend: 'Língua', vocab: V.languages, pick: (r) => r.languages },
  { param: 'periodo', legend: 'Período do conteúdo', vocab: periodVocab, pick: (r) => periodKeys(r) },
  { param: 'acesso', legend: 'Regime de acesso', vocab: V.accessLevels, pick: (r) => [r.access_level] },
  { param: 'status', legend: 'Verificação', vocab: V.contentStatuses, pick: (r) => [r.content_status] },
  {
    param: 'relacao',
    legend: 'Relação comunitária',
    vocab: V.communityEvidenceKinds,
    pick: (r) => [r.community_evidence.kind],
    note: 'O que as fontes dizem sobre a relação com a comunidade.',
  },
  { param: 'host', legend: 'Quem mantém', vocab: V.stewardshipTypes, pick: (r) => [r.stewardship_or_host.type] },
];

const facetOptions = facets.map((f) => {
  const counts = facetCounts(published, f.pick);
  const options = Object.keys(f.vocab)
    .filter((k) => counts.has(k))
    .map((k) => ({ key: k, label: f.vocab[k], count: counts.get(k)! }));
  return { ...f, options };
});

const site = new URL(sitePath('/'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.subtitle,
  url: site,
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${site}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---
<Base current="inicio" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="intro">
      <h1>{siteConfig.name}</h1>
      <p class="intro-subtitle">{siteConfig.subtitle}</p>
    </header>

    <form id="filtros" class="filters" action={sitePath('/')} method="get" role="search" aria-label="Buscar e filtrar acervos">
      <div class="catalog-toolbar">
        <div class="search">
          <label for="q" class="visually-hidden">Buscar no catálogo</label>
          <input id="q" name="q" type="search" placeholder="Buscar acervos" autocomplete="off" />
          <button class="btn" type="submit">Buscar</button>
        </div>
        <button id="mais-filtros" class="btn" type="button" aria-controls="campos-filtros" aria-expanded="false" hidden>
          Filtros <span id="n-filtros" class="meta"></span>
        </button>
      </div>
      <div id="campos-filtros" class="filter-panel" hidden>
        <div class="filter-fields">
          <div class="field">
            <label for="ordem" class="kicker">Ordenar por</label>
            <select id="ordem" name="ordem">
              <option value="">Padrão</option>
              <option value="nome">Nome (A–Z)</option>
              <option value="atualizacao">Atualização mais recente</option>
              <option value="inclusao">Inclusão mais recente</option>
              <option value="relevancia">Correspondência com a busca</option>
            </select>
            <p class="meta muted hint">Ao buscar, os resultados mais relevantes aparecem primeiro.</p>
          </div>
          {facetOptions.map((f) => (
            <div class="field">
              <label for={`f-${f.param}`} class="kicker">{f.legend}</label>
              <select id={`f-${f.param}`} name={f.param} data-facet={f.param}>
                <option value="">Todos</option>
                {f.options.map((o) => (
                  <option value={o.key}>{o.label} ({o.count})</option>
                ))}
              </select>
              {f.note && <p class="meta muted hint">{f.note}</p>}
            </div>
          ))}
        </div>
        <a class="reset-filters" href={sitePath('/')} id="limpar">Limpar filtros</a>
      </div>
      <noscript><p class="meta muted">Ative o JavaScript para buscar ou filtrar os acervos.</p></noscript>
    </form>

    <div id="chips" class="chips" aria-label="Filtros ativos"></div>
    <p id="contagem" role="status" aria-live="polite" class="visually-hidden">{published.length} acervos</p>
    <p id="vazio" class="callout" hidden>Nenhum acervo encontrado. Tente usar menos palavras ou limpar um filtro.</p>
    <ul id="lista" class="collection-grid" aria-label="Coleções digitais">
      {sorted.map((record, i) => {
        const title = shortNames[record.id] ?? record.name;
        return (
          <li
            class="tile"
            data-collection={record.id}
            data-id={record.id}
            data-name={record.name}
            data-updated={record.updated_at}
            data-created={record.created_at}
            data-search={JSON.stringify(searchFields(record, collectionViews[record.id]?.map(([label]) => label) ?? [], collectionSubtitles[record.id]))}
            {...Object.fromEntries(facets.map((f) => [`data-${f.param}`, f.pick(record).join(' ')]))}
          >
            <CollectionCover id={record.id} name={title} eager={i < 3} priority={i === 0} />
            <div class="tile-heading">
              <h2 class="collection-tile-title"><a class="tile-link" href={recordPath(record.id)} data-open={record.id}>{title}</a></h2>
              <a class="tile-source" data-archive-source={record.id} href={record.digital_collection_url} target="_blank" rel="noopener noreferrer external"
                aria-label={`Abrir ${title} no site de origem (nova aba)`} title="Abrir acervo original em nova aba">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M13 5h6v6M19 5l-8 8M10 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" />
                </svg>
              </a>
            </div>
            <p class="tile-subtitle">{collectionSubtitles[record.id] ?? record.description.pt}</p>
            <p class="tile-location">
              {record.country.map((country) => V.label(V.countries, country)).join(', ')}
              {record.id === 'diseno-nacional' && <span> · Captura CC BY-NC</span>}
            </p>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<script>
  import '../lib/catalog-browser';
</script>

<style>
  .intro {
    padding-bottom: clamp(1.35rem, 3vw, 2.5rem);
  }
  h1 {
    font-family: var(--f-title);
    font-size: clamp(2.75rem, 1.05rem + 5.7vw, 6.4rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.97;
    text-wrap: balance;
    margin: 0;
  }
  .intro-subtitle { margin: 0.65rem 0 0; color: var(--muted); }
  .filters { margin-bottom: 1.4rem; }
  .catalog-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem 1rem;
    border-block: 1px solid var(--rule);
    padding-block: 0.7rem;
  }
  .search { display: flex; flex: 0 1 26rem; min-width: 0; gap: 0.35rem; }
  .search input { flex: 1; min-width: 0; }
  .catalog-toolbar .btn, .search input { min-height: 2.75rem; }
  .filter-panel { border-bottom: 1px solid var(--rule); padding-block: 0.8rem; }
  .filter-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.7rem 1rem;
  }
  .field { display: grid; align-content: start; gap: 0.2rem; min-width: 0; }
  .field select { width: 100%; }
  .hint { margin: 0; }
  .reset-filters { display: inline-block; padding-top: 0.7rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.85rem; }
  .chips:empty { display: none; }

  .tile { position: relative; }
  .tile-heading { display: flex; justify-content: space-between; align-items: start; gap: 0.5rem; }
  .tile-link::after { content: ''; position: absolute; inset: 0; }
  .tile-link:focus-visible::after { outline: 2px solid currentColor; outline-offset: 4px; }
  .tile-source {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: 0 0 2.75rem;
    height: 2.75rem;
    color: var(--muted);
  }
  .tile-source:hover, .tile-source:focus-visible { color: var(--ink); background: var(--paper-2); }
  .tile-subtitle {
    font-size: 0.95rem;
    line-height: 1.45;
    margin: 0.35rem 0 0;
  }
  .tile-location {
    color: var(--muted);
    font-size: 0.82rem;
    margin: 0.35rem 0 0;
  }
  @supports (grid-template-rows: subgrid) {
    #lista { row-gap: 0; }
    .tile {
      display: grid;
      grid-row: span 4;
      grid-template-rows: subgrid;
      padding-bottom: clamp(1.5rem, 3vw, 2.4rem);
    }
    .tile[hidden] { display: none; }
  }
  @media (max-width: 34rem) {
    .search { flex: 1 1 13rem; }
  }
</style>
