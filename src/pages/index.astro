---
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import ExtLink from '../components/ExtLink.astro';
import MediaPlate from '../components/MediaPlate.astro';
import { siteConfig } from '../site.config';
import * as V from '../data/vocabulario';
import {
  getAll,
  getPublished,
  isFeaturable,
  lastUpdate,
  formatDate,
  facetCounts,
  recordPath,
} from '../lib/acervos';

const all = await getAll();
const published = await getPublished();
// Com imagem licenciada primeiro: a obra é a protagonista quando pode ser.
const featured = published
  .filter(isFeaturable)
  .sort((a, b) => Number(b.media.length > 0) - Number(a.media.length > 0) || a.name.localeCompare(b.name, 'pt'));
const pendingCount = all.filter((r) => r.record_status === 'rascunho').length;
const updated = lastUpdate(all);

const byCountry = [...facetCounts(published, (r) => r.country)].sort((a, b) => b[1] - a[1]);
const byTheme = [...facetCounts(published, (r) => r.themes)].sort((a, b) => b[1] - a[1]).slice(0, 8);
const byType = [...facetCounts(published, (r) => r.collection_types)].sort((a, b) => b[1] - a[1]).slice(0, 8);

const site = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.subtitle,
  url: site,
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${site}explorar/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---
<Base current="inicio" jsonLd={jsonLd}>
  <div class="wrap home">
    <section class="intro" aria-labelledby="titulo">
      <h1 id="titulo">{siteConfig.name}</h1>
      <p class="sub">{siteConfig.subtitle}</p>
      <p class="lede">
        Um índice de iniciativas e arquivos do Brasil e da América Latina com conteúdo digital que
        dá para abrir agora. Cada registro aponta para a fonte e diz o que foi visto, quando, e o
        que ainda não se sabe.
      </p>
      <form class="search" action="/explorar/" method="get" role="search">
        <label for="q-home" class="visually-hidden">Buscar por nome, tema, lugar ou tipo de acervo</label>
        <input id="q-home" name="q" type="search" placeholder="Buscar: cartaz, Amapá, memória trans…" />
        <button class="btn btn--primary" type="submit">Buscar</button>
      </form>
      <p class="meta muted">
        {`Curadoria em construção · atualizada em `}<time datetime={updated}>{formatDate(updated)}</time>
        {` · ${published.length} registros publicados · ${pendingCount} em revisão · `}<a href="/metodologia/">método</a>
      </p>
    </section>

    <section aria-labelledby="amostras" class="samples">
      <h2 id="amostras" class="kicker">Amostras abertas na última verificação</h2>
      <ol class="feature-list">
        {featured.map((r, i) => (
          <li class={r.media.length ? 'with-media' : 'no-media'}>
            <div class="f-media">
              <MediaPlate record={r} variant="feature" eager={i === 0} />
            </div>
            <div class="f-text">
              <p class="kicker">{r.country.map((c) => V.label(V.countries, c)).join(' · ')} · {V.label(V.initiativeTypes, r.initiative_type)}</p>
              <h3><a href={recordPath(r.id)}>{r.name}</a></h3>
              <p>{r.sample.observed}</p>
              <p class="meta">
                <Status status={r.content_status} /> · {formatDate(r.last_verified_at)} ·{' '}
                <ExtLink href={r.sample_content_url}>abrir na fonte</ExtLink>
              </p>
            </div>
          </li>
        ))}
      </ol>
      <p><a class="btn" href="/explorar/">Explorar todos os registros</a></p>
    </section>

    <section class="explore" aria-labelledby="percursos">
      <h2 id="percursos" class="kicker">Percursos</h2>
      <div class="explore-cols">
        <div>
          <h3 class="kicker">Território</h3>
          <ul class="tags big">
            {byCountry.map(([k]) => <li><a href={`/explorar/?pais=${k}`}>{V.label(V.countries, k)}</a></li>)}
          </ul>
        </div>
        <div>
          <h3 class="kicker">Temas</h3>
          <ul class="tags big">
            {byTheme.map(([k]) => <li><a href={`/explorar/?tema=${k}`}>{V.label(V.themes, k)}</a></li>)}
          </ul>
        </div>
        <div>
          <h3 class="kicker">Formas de acervo</h3>
          <ul class="tags big">
            {byType.map(([k]) => <li><a href={`/explorar/?tipo=${k}`}>{V.label(V.collectionTypes, k)}</a></li>)}
          </ul>
        </div>
      </div>
      <p class="meta muted">
        Não é ranking nem selo: os registros descrevem o que foi verificado e o que falta saber.{' '}
        <a href="/sobre/">Sobre o projeto</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .intro {
    padding-block: 0.5rem 1.5rem;
    max-width: 52rem;
  }
  h1 {
    font-size: var(--step-3);
    margin-bottom: 0.6rem;
  }
  h1 {
    margin-bottom: 0.2rem;
  }
  .sub {
    font-family: var(--f-display);
    font-size: var(--step-1);
    color: var(--red);
    margin: 0 0 0.8rem;
  }
  .lede {
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .search {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 0.8rem;
    max-width: 40rem;
  }
  .search input {
    flex: 1;
    min-width: 0;
  }
  .samples {
    margin-top: 1.5rem;
  }
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    border-top: 1px solid var(--rule);
  }
  .feature-list > li {
    display: grid;
    gap: 1rem 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 52rem) {
    .feature-list > li.with-media {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: end;
    }
    .feature-list > li.no-media {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
    }
  }
  .f-text h3 {
    font-size: var(--step-2);
    margin: 0 0 0.5rem;
  }
  .f-text h3 a {
    text-decoration: none;
  }
  .explore {
    margin: 2rem 0;
  }
  .explore-cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .tags.big li {
    font-family: var(--f-display);
    font-stretch: condensed;
    font-size: var(--step-1);
    border-bottom: 0;
  }
</style>
