---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import CollectionCover from '../components/CollectionCover.astro';
import { siteConfig } from '../site.config';
import collectionPreviews from '../data/collection-previews.json';
import { collectionSubtitles } from '../data/collection-views';
import { countries, label } from '../data/vocabulario';
import {
  getPublished,
  recordPath,
} from '../lib/acervos';

const published = await getPublished();
const order = ['diseno-nacional', 'biblioteca-de-zines', 'casca', 'irohin', 'archivo-memoria-trans', 'museu-kuahi', 'cartel-mexico'];
const sorted = [
  ...order.flatMap((id) => published.filter((record) => record.id === id)),
  ...published.filter((record) => !order.includes(record.id)),
];
const shortNames: Record<string, string> = {
  'diseno-nacional': 'Diseño Nacional',
  irohin: 'Ìrohìn',
};

const previews: Partial<Record<string, { page: string }>> = collectionPreviews;

const site = new URL(sitePath('/'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.subtitle,
  url: site,
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${site}explorar/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---
<Base current="inicio" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="intro">
      <div class="masthead">
        <h1>{siteConfig.name}</h1>
        <nav aria-label="Principal">
          <a href={sitePath('/explorar/')}>Explorar</a>
          <a href={sitePath('/comparar/')}>Comparar</a>
          <a href={sitePath('/sobre/')}>Sobre</a>
        </nav>
      </div>
      <div class="intro-row">
        <p>{siteConfig.subtitle}</p>
        <form class="search" action={sitePath('/explorar/')} method="get" role="search">
          <label for="q-home" class="visually-hidden">Buscar no catálogo</label>
          <input id="q-home" name="q" type="search" placeholder="Nome, tema ou lugar" />
          <button class="btn" type="submit">Buscar</button>
        </form>
      </div>
    </header>

    <ul class="collection-grid" aria-label="Coleções digitais">
      {sorted.map((record, i) => {
        const title = shortNames[record.id] ?? record.name;
        const preview = previews[record.id];
        return (
          <li class="tile" data-collection={record.id}>
            <a href={preview?.page ?? record.digital_collection_url} class="collection" rel="noopener noreferrer external">
              <span class="visually-hidden">Abrir coleção {title}</span>
              <CollectionCover id={record.id} name={title} eager={i < 3} priority={i === 0} />
            </a>
            <h2 class="collection-tile-title"><a href={recordPath(record.id)}>{title}</a></h2>
            <p class="tile-subtitle">{collectionSubtitles[record.id] ?? record.description.pt}</p>
            <p class="tile-location">
              {record.country.map((country) => label(countries, country)).join(', ')}
              {record.id === 'diseno-nacional' && <span> · Captura CC BY-NC</span>}
            </p>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(1.4rem, 4vw, 3.4rem) clamp(1.8rem, 4vw, 3rem);
  }
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }
  nav { display: flex; gap: 1rem; font-size: 0.9rem; margin-bottom: 0.85rem; }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  h1 {
    font-family: var(--f-title);
    font-size: clamp(2.75rem, 1.1rem + 7.2vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    margin-bottom: 0.16em;
  }
  .intro-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
  }
  .intro p { margin: 0; color: var(--muted); }
  .search { display: flex; flex: 0 1 21rem; gap: 0.35rem; }
  .search input { flex: 1; min-width: 0; }

  .collection { display: block; text-decoration: none; }
  .collection:hover :global(.collection-cover) { outline: 1px solid var(--muted); outline-offset: -1px; }
  h2 a { display: inline-block; min-height: 24px; }
  .tile-subtitle {
    font-size: 0.95rem;
    line-height: 1.45;
    margin: 0.35rem 0 0;
  }
  .tile-location {
    color: var(--muted);
    font-size: 0.82rem;
    margin: 0.35rem 0 0;
  }
  @media (max-width: 34rem) {
    .masthead nav { order: 1; margin-block: 0.1rem 0.6rem; }
  }
</style>
