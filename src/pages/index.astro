---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import cascaPoster from '../assets/acervos/casca-7647.jpg';
import { siteConfig } from '../site.config';
import * as V from '../data/vocabulario';
import { collectionViews } from '../data/collection-views';
import {
  getPublished,
  recordPath,
} from '../lib/acervos';

const published = await getPublished();
const order = ['diseno-nacional', 'biblioteca-de-zines', 'casca', 'irohin', 'archivo-memoria-trans', 'museu-kuahi', 'cartel-mexico'];
const sorted = [
  ...order.flatMap((id) => published.filter((record) => record.id === id)),
  ...published.filter((record) => !order.includes(record.id)),
];
const shortNames: Record<string, string> = {
  'diseno-nacional': 'Diseño Nacional',
  irohin: 'Ìrohìn',
};

const compositions: Record<string, string> = {
  'biblioteca-de-zines': 'bindings',
  casca: 'bindings',
  irohin: 'documents',
  'archivo-memoria-trans': 'documents',
  'museu-kuahi': 'objects',
  'cartel-mexico': 'bindings',
  'xingu-entangled': 'network',
  'tipomap-latam': 'type',
  'mexico-disena': 'bindings',
  'grafica-latina': 'bindings',
  'acervo-da-laje': 'objects',
};

const site = new URL(sitePath('/'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.subtitle,
  url: site,
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${site}explorar/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---
<Base current="inicio" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="intro">
      <div class="masthead">
        <h1>{siteConfig.name}</h1>
        <nav aria-label="Principal">
          <a href={sitePath('/explorar/')}>Explorar</a>
          <a href={sitePath('/comparar/')}>Comparar</a>
          <a href={sitePath('/sobre/')}>Sobre</a>
        </nav>
      </div>
      <div class="intro-row">
        <p>{siteConfig.subtitle}</p>
        <form class="search" action={sitePath('/explorar/')} method="get" role="search">
          <label for="q-home" class="visually-hidden">Buscar no catálogo</label>
          <input id="q-home" name="q" type="search" placeholder="Nome, tema ou lugar" />
          <button class="btn" type="submit">Buscar</button>
        </form>
      </div>
    </header>

    <ul class="grid" aria-label="Coleções digitais">
      {sorted.map((record) => {
        const title = shortNames[record.id] ?? record.name;
        const links = collectionViews[record.id];
        const labels = links?.map(([label]) => label)
          ?? record.collection_types.slice(0, 3).map((type) => V.label(V.collectionTypes, type));
        // Captura da grade original em 22/11/2026, com créditos das fichas preservados.
        const source = record.id === 'diseno-nacional'
          ? 'https://www.disenonacional.cl/carteles/carteles-culturales/'
          : record.digital_collection_url;
        return (
          <li class="tile">
            <a href={source} class="collection" rel="noopener noreferrer external">
              <span class="visually-hidden">Abrir coleção {title}: </span>
              <div class:list={['preview', compositions[record.id]]}>
                {record.id === 'diseno-nacional' ? (
                  <img src={sitePath('/colecoes/diseno-nacional.jpg')} width="840" height="550" fetchpriority="high" alt="Grade de cartazes culturais do catálogo Diseño Nacional" />
                ) : (
                  <>
                    <span class="visually-hidden">{labels.join(', ')}</span>
                    <div class="specimens" aria-hidden="true">
                      {labels.map((label, i) => (
                        <span>
                          {record.id === 'casca' && i === 0 ? (
                            <Image src={cascaPoster} alt="" width={184} />
                          ) : (
                            <span class="shape"></span>
                          )}
                          {record.id !== 'biblioteca-de-zines' && i !== 0 && <small>{label}</small>}
                        </span>
                      ))}
                    </div>
                  </>
                )}
              </div>
            </a>
            <h2><a href={recordPath(record.id)}>{title}</a></h2>
            {record.id === 'diseno-nacional' && (
              <p class="credit">Captura: Diseño Nacional (CC BY-NC)</p>
            )}
            {record.id === 'casca' && <p class="credit">Cartaz: Arquivo CASCA (CC0)</p>}
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(1.4rem, 4vw, 3.4rem) clamp(1.8rem, 4vw, 3rem);
  }
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }
  nav { display: flex; gap: 1rem; font-size: 0.9rem; margin-bottom: 0.85rem; }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  h1 {
    font-family: Didot, "Bodoni MT", "Bodoni 72", "Times New Roman", serif;
    font-size: clamp(2.75rem, 1.1rem + 7.2vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    margin-bottom: 0.16em;
  }
  .intro-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
  }
  .intro p { margin: 0; color: var(--muted); }
  .search { display: flex; flex: 0 1 21rem; gap: 0.35rem; }
  .search input { flex: 1; min-width: 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.4rem clamp(0.9rem, 2vw, 1.6rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tile { min-width: 0; }
  .collection { display: block; text-decoration: none; }
  .collection:hover .preview { outline: 1px solid var(--muted); outline-offset: -1px; }
  .preview {
    min-height: 9rem;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: #f2f1ec;
    overflow: hidden;
  }
  .tile:nth-child(4n + 2) .preview { background: #efebf3; }
  .tile:nth-child(4n + 3) .preview { background: #e8eee5; }
  .tile:nth-child(4n + 4) .preview { background: #f3ebe5; }
  .preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .specimens {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    align-items: end;
    gap: 0.65rem;
    width: 85%;
  }
  .specimens > span { min-width: 0; }
  .specimens small { display: block; font-size: 0.75rem; margin-top: 0.4rem; }
  .specimens img { aspect-ratio: 619 / 800; height: auto; align-self: end; }
  .shape {
    display: block;
    aspect-ratio: 3 / 4;
    background-color: #c8c9bf;
    background-image: repeating-linear-gradient(0deg, transparent 0 12%, rgb(34 37 34 / 18%) 12% 13%);
  }
  .specimens > span:nth-child(2) .shape { background-color: #b0b6a7; }
  .specimens > span:nth-child(3) .shape { background-color: #d8c1ae; }
  .bindings .specimens > span:first-child .shape {
    background: repeating-linear-gradient(90deg, #543750 0 9%, #d7a594 9% 15%, #ece0d4 15% 21%);
  }
  .bindings .specimens > span:nth-child(2) .shape {
    background: linear-gradient(135deg, #d4af80 49%, #4b5442 50%);
  }
  .bindings .specimens > span:nth-child(3) .shape {
    background: radial-gradient(circle at 65% 34%, #efe2b8 0 24%, transparent 25%), #534560;
  }
  .documents .specimens { align-items: center; }
  .documents .shape {
    background: repeating-linear-gradient(#faf7ee 0 10%, #b7806e 10% 11%, #faf7ee 11% 15%);
    border: 1px solid #b9aa96;
  }
  .objects .shape { border-radius: 49% 49% 23% 23%; background: #997459; }
  .objects .specimens > span:nth-child(2) .shape { border-radius: 50%; background: #656047; }
  .network .shape { border-radius: 50%; background: #6e8773; aspect-ratio: 1; }
  .network .specimens { align-items: center; }
  .type .shape { background: transparent; font-family: Didot, Georgia, serif; }
  .type .shape::before { content: "Aa"; font-size: clamp(3rem, 7vw, 7rem); line-height: 1; }
  h2 {
    font-size: clamp(1.14rem, 0.9rem + 0.65vw, 1.55rem);
    letter-spacing: -0.025em;
    margin: 0.55rem 0 0;
  }
  h2 a { display: inline-block; min-height: 24px; text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .credit {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    width: fit-content;
    margin: 0.22rem 0 0;
  }
  @media (max-width: 57rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 34rem) {
    .grid { grid-template-columns: 1fr; gap: 1.55rem; }
    .preview { aspect-ratio: 3 / 2; }
    .masthead nav { order: 1; margin-block: 0.1rem 0.6rem; }
  }
</style>
