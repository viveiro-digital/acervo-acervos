---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" noindex>
  <div class="wrap">
    <p class="kicker">Erro 404</p>
    <h1>Página não encontrada</h1>
    <p>
      Se estava procurando um acervo, <a href={sitePath('/')}>busque pelo nome no catálogo</a>.
    </p>
  </div>
</Base>
