---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" noindex>
  <div class="wrap">
    <p class="kicker">Erro 404</p>
    <h1>Esta página não existe (ou mudou de endereço)</h1>
    <p>
      Se você seguiu um link para um registro, ele pode ter sido renomeado. Tente o{' '}
      <a href="/explorar/">índice completo</a> ou a <a href="/">página inicial</a>.
    </p>
  </div>
</Base>
