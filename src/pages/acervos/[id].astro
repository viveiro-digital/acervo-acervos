---
import { sitePath } from '../../lib/site-path';
import Base from '../../layouts/Base.astro';
import ExtLink from '../../components/ExtLink.astro';
import CollectionCover from '../../components/CollectionCover.astro';
import { collectionViews } from '../../data/collection-views';
import { siteConfig } from '../../site.config';
import * as V from '../../data/vocabulario';
import {
  getPublished, formatDate, recordPath, type Acervo,
} from '../../lib/acervos';

export async function getStaticPaths() {
  const records = await getPublished();
  const pages = records.map((r) => ({ params: { id: r.id }, props: { record: r, redirectTo: null } }));
  // Slugs antigos: página mínima que redireciona para o endereço atual.
  const redirects = records.flatMap((r) =>
    r.previous_ids.map((old) => ({ params: { id: old }, props: { record: r, redirectTo: recordPath(r.id) } })),
  );
  return [...pages, ...redirects];
}

interface Props {
  record: Acervo;
  redirectTo: string | null;
}
const { record: r, redirectTo } = Astro.props;
const place = [r.city, r.region, ...r.country.map((c) => V.label(V.countries, c))].filter(Boolean).join(', ');
const description = r.description.pt;
const sections = (collectionViews[r.id] ?? []).filter(([, url]) => url !== r.digital_collection_url);
const accessNote = r.access_requirements;
const canonical = new URL(recordPath(r.id), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: `${r.name} — ${siteConfig.name}`,
    description: r.description.pt,
    inLanguage: 'pt-BR',
    dateModified: r.updated_at,
    datePublished: r.created_at,
    isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: new URL(sitePath('/'), Astro.site).href },
    // A página descreve uma coleção digital mantida por terceiros.
    about: {
      '@type': 'Collection',
      name: r.preferred_name ?? r.name,
      alternateName: r.alternative_names.length ? r.alternative_names : undefined,
      url: r.digital_collection_url,
      sameAs: r.initiative_url,
      inLanguage: r.languages,
      spatialCoverage: r.country.filter((c) => c !== 'LATAM').map((c) => ({ '@type': 'Country', name: V.label(V.countries, c) })),
      keywords: r.themes.map((t) => V.label(V.themes, t)).join(', ') || undefined,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(sitePath('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: r.name, item: canonical },
    ],
  },
];
---
{redirectTo ? (
  <html lang="pt-BR">
    <head>
      <meta charset="utf-8" />
      <title>Endereço alterado — Acervo Acervos</title>
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <link rel="canonical" href={new URL(redirectTo, Astro.site).href} />
      <meta name="robots" content="noindex" />
    </head>
    <body>
      <p>Este registro mudou de endereço: <a href={redirectTo}>{r.name}</a>.</p>
    </body>
  </html>
) : (
<Base title={r.name} description={description} ogType="article" jsonLd={jsonLd}>
  <article class="wrap record" data-record={r.id}>
    <a class="record-back" href={sitePath('/')}>Todos os acervos</a>
    <header class="record-head">
      <div class="record-heading">
        <p class="meta muted">{place}</p>
        <h1 data-record-title>{r.name}</h1>
      </div>
      <div class="record-hero">
        <CollectionCover id={r.id} name={r.name} eager priority />
      </div>
      <div class="record-intro">
        <div>
          <p class="lede">{r.description.pt}</p>
          {accessNote && <p class="meta muted">{accessNote}</p>}
        </div>
        <ExtLink href={r.digital_collection_url} class="btn btn--primary">Explorar a coleção</ExtLink>
      </div>
    </header>

    {(sections.length > 0 || r.sample_content_url !== r.digital_collection_url) && (
      <section class="record-discovery" aria-labelledby="colecao-partes">
        <h2 id="colecao-partes">Na coleção</h2>
        <ul class="record-links">
          {sections.map(([label, url]) => (
            <li><ExtLink href={url}>{label}</ExtLink></li>
          ))}
          {!sections.some(([, url]) => url === r.sample_content_url) && r.sample_content_url !== r.digital_collection_url && (
            <li><ExtLink href={r.sample_content_url}>{r.sample.title}</ExtLink></li>
          )}
        </ul>
      </section>
    )}

    <details class="record-notes">
      <summary>Notas e fontes</summary>
      <div class="record-notes-body">
        <h2>O que conferimos</h2>
        <p class="meta muted">Consulta em <time datetime={r.last_verified_at}>{formatDate(r.last_verified_at)}</time>.</p>
        <p>{r.sample.observed}</p>
        {r.platform && <p class="meta muted">Plataforma identificada: {r.platform.software}.</p>}
        {r.community_protocol && <p>{r.community_protocol}</p>}
        {r.relationship_disclosure && <p>{r.relationship_disclosure}</p>}
        <h2>Fontes consultadas</h2>
        <ul class="record-links">
          <li><ExtLink href={r.initiative_url}>Site da iniciativa</ExtLink></li>
          {r.sample_content_url !== r.initiative_url && (
            <li><ExtLink href={r.sample_content_url}>{r.sample.title}</ExtLink></li>
          )}
          {r.rights_and_reuse.source_url && r.rights_and_reuse.statement !== 'desconhecido' &&
            r.rights_and_reuse.source_url !== r.sample_content_url && r.rights_and_reuse.source_url !== r.initiative_url && (
              <li><ExtLink href={r.rights_and_reuse.source_url}>Condições de uso na fonte</ExtLink></li>
            )}
          {siteConfig.repoUrl && <li><ExtLink href={`${siteConfig.repoUrl}/blob/main/src/content/acervos/${r.id}.yaml`}>Ficha e referências no repositório</ExtLink></li>}
        </ul>
      </div>
    </details>
  </article>
</Base>
)}
