---
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import ExtLink from '../../components/ExtLink.astro';
import * as V from '../../data/vocabulario';
import { getPublished, related, formatDate, recordPath, type Acervo } from '../../lib/acervos';

export async function getStaticPaths() {
  const records = await getPublished();
  const pages = records.map((r) => ({ params: { id: r.id }, props: { record: r, redirectTo: null } }));
  // Slugs antigos: página mínima que redireciona para o endereço atual.
  const redirects = records.flatMap((r) =>
    r.previous_ids.map((old) => ({ params: { id: old }, props: { record: r, redirectTo: recordPath(r.id) } })),
  );
  return [...pages, ...redirects];
}

interface Props {
  record: Acervo;
  redirectTo: string | null;
}
const { record: r, redirectTo } = Astro.props;
const all = await getPublished();
const rel = related(r, all);
const place = [r.city, r.region, ...r.country.map((c) => V.label(V.countries, c))].filter(Boolean).join(', ');
const description = `${r.description.pt} Amostra verificada: ${r.sample.title}.`;
---
{redirectTo ? (
  <html lang="pt-BR">
    <head>
      <meta charset="utf-8" />
      <title>Endereço alterado — Acervo Acervos</title>
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <link rel="canonical" href={new URL(redirectTo, Astro.site).href} />
      <meta name="robots" content="noindex" />
    </head>
    <body>
      <p>Este registro mudou de endereço: <a href={redirectTo}>{r.name}</a>.</p>
    </body>
  </html>
) : (
<Base title={r.name} description={description} ogType="article">
  <article class="wrap record">
    <header class="record-head">
      <p class="kicker">
        {V.label(V.initiativeTypes, r.initiative_type)} · {place}
      </p>
      <h1>{r.name}</h1>
      {r.alternative_names.length > 0 && (
        <p class="meta muted">Também: {r.alternative_names.join(' · ')}</p>
      )}
      <p class="lede">{r.description.pt}</p>
      <div class="cta">
        <ExtLink href={r.initiative_url} class="btn">Site da iniciativa</ExtLink>
        <ExtLink href={r.digital_collection_url} class="btn btn--primary">Explorar a coleção</ExtLink>
      </div>
      {r.access_channel && (
        <p class="margin-note">
          Canal de acesso: <strong>{r.access_channel.platform}</strong>. {r.access_channel.limitations}
        </p>
      )}
    </header>

    <div class="cols">
      <div class="main">
        <section class="sample reg" aria-labelledby="amostra">
          <p class="kicker" id="amostra">Amostra específica</p>
          <h2>{r.sample.title}</h2>
          <p>{r.sample.observed}</p>
          <dl class="fields">
            {r.sample.creator && (<><dt>Autoria (fonte)</dt><dd>{r.sample.creator}</dd></>)}
            {r.sample.date && (<><dt>Data (fonte)</dt><dd>{r.sample.date}</dd></>)}
            <dt>O que foi confirmado</dt>
            <dd>
              {r.sample.confirmed_media.length
                ? r.sample.confirmed_media.map((m) => V.label(V.formats, m)).join(', ')
                : 'Nenhuma mídia confirmada.'}
            </dd>
            <dt>Descrição da imagem</dt>
            <dd>
              {r.sample.alt_from_source
                ? <>“{r.sample.alt_from_source}” <span class="meta muted">(texto alternativo da fonte)</span></>
                : 'Descrição ainda não fornecida pela fonte.'}
            </dd>
            {r.sample.rights_text && (<><dt>Direitos (amostra)</dt><dd>{r.sample.rights_text}</dd></>)}
          </dl>
          <p class="open-sample"><ExtLink href={r.sample_content_url} class="btn btn--primary">Abrir a amostra na fonte</ExtLink></p>
          <p class="meta muted">
            Acervo Acervos não reproduz a obra; ela continua na página da iniciativa.
          </p>
        </section>

        <section aria-labelledby="porque">
          <h2 id="porque">Por que esta iniciativa está aqui?</h2>
          <p>{r.curatorial_reason.pt}</p>
          {r.self_description && (
            <blockquote class="self" lang={r.self_description.lang}>
              <p>{r.self_description.text}</p>
              <footer class="meta">
                Autodescrição ({V.label(V.languages, r.self_description.lang)}) —{' '}
                <ExtLink href={r.self_description.source_url} label="fonte da autodescrição">fonte</ExtLink>
              </footer>
            </blockquote>
          )}
        </section>

        <section aria-labelledby="quem">
          <h2 id="quem">Quem mantém e com quem</h2>
          <dl class="fields">
            <dt>Mantém / hospeda</dt>
            <dd>
              <strong>{V.label(V.stewardshipTypes, r.stewardship_or_host.type)}</strong>
              {r.stewardship_or_host.name && <> — {r.stewardship_or_host.name}</>}
              <br />{r.stewardship_or_host.note}
              {r.stewardship_or_host.source_url && <> <ExtLink href={r.stewardship_or_host.source_url} label="fonte sobre quem mantém">fonte</ExtLink></>}
            </dd>
            <dt>Relação comunitária</dt>
            <dd>
              <strong>{V.label(V.communityEvidenceKinds, r.community_evidence.kind)}</strong>
              <br />{r.community_evidence.note}
              {r.community_evidence.source_url && <> <ExtLink href={r.community_evidence.source_url} label="fonte sobre a relação comunitária">fonte</ExtLink></>}
            </dd>
            {r.provenance_note && (<><dt>Procedência</dt><dd>{r.provenance_note}</dd></>)}
          </dl>
          <p class="meta muted">
            Quem mantém o acervo e a comunidade representada nele são informações diferentes,
            registradas separadamente.
          </p>
        </section>

        <section aria-labelledby="acesso">
          <h2 id="acesso">Acesso, direitos e cuidados</h2>
          <dl class="fields">
            <dt>Regime de acesso</dt>
            <dd>{V.label(V.accessLevels, r.access_level)}{r.access_requirements && <> — {r.access_requirements}</>}</dd>
            {r.access_notes && (<><dt>Notas de acesso</dt><dd>{r.access_notes}</dd></>)}
            <dt>Direitos e reuso</dt>
            <dd>
              {r.rights_and_reuse.statement === 'desconhecido'
                ? 'Desconhecido: a fonte não informa ou não localizamos.'
                : r.rights_and_reuse.statement}
              {r.rights_and_reuse.source_url && <> <ExtLink href={r.rights_and_reuse.source_url} label="fonte sobre direitos e reuso">fonte</ExtLink></>}
            </dd>
            {r.community_protocol && (<><dt>Protocolo comunitário</dt><dd>{r.community_protocol}</dd></>)}
            {r.sensitive_content_note && (<><dt>Conteúdo sensível</dt><dd>{r.sensitive_content_note}</dd></>)}
            {r.removal_or_contact_url && (
              <><dt>Contato da iniciativa</dt><dd><ExtLink href={r.removal_or_contact_url}>{r.removal_or_contact_url.replace(/^mailto:/, '')}</ExtLink></dd></>
            )}
          </dl>
          <p class="meta muted">
            Estar digitalizado, ter acesso público, permitir reuso e estar preservado a longo prazo
            são coisas diferentes. Este registro só afirma o que a fonte declara.
          </p>
        </section>

        {r.relationship_disclosure && (
          <section class="callout callout--warn" aria-labelledby="vinculo">
            <h2 id="vinculo">Vínculo da curadoria</h2>
            <p>{r.relationship_disclosure}</p>
          </section>
        )}

        <section aria-labelledby="evidencias">
          <h2 id="evidencias">Evidências e fontes</h2>
          <ol class="evidence">
            {r.evidence.map((e, i) => (
              <li>
                <p>{e.claim}</p>
                <p class="meta">
                  {V.label(V.evidenceKinds, e.kind)} · certeza {V.label(V.certaintyLevels, e.certainty).toLowerCase()} ·
                  consultado em <time datetime={e.accessed_at}>{formatDate(e.accessed_at)}</time> ·{' '}
                  <ExtLink href={e.source_url} label={`fonte ${i + 1}: ${e.claim}`}>fonte</ExtLink>
                </p>
                {e.note && <p class="meta muted">{e.note}</p>}
              </li>
            ))}
          </ol>
          {r.gaps.length > 0 && (
            <>
              <h3>O que ainda não sabemos</h3>
              <ul>{r.gaps.map((g) => <li>{g}</li>)}</ul>
            </>
          )}
        </section>
      </div>

      <aside class="side" aria-label="Ficha">
        <div class="box">
          <p class="kicker">Verificação</p>
          <Status status={r.content_status} help />
          <dl class="fields compact">
            <dt>Última verificação</dt>
            <dd><time datetime={r.last_verified_at}>{formatDate(r.last_verified_at)}</time></dd>
            <dt>Link</dt>
            <dd>{V.label(V.linkStatuses, r.link_status)}</dd>
            <dt>Como</dt>
            <dd>{r.verification_method}</dd>
          </dl>
          {r.review_flag && (
            <p class="meta flag">Em revisão: {r.review_reason}</p>
          )}
        </div>
        <div class="box">
          <p class="kicker">Ficha</p>
          <dl class="fields compact">
            <dt>Lugar</dt><dd>{place}{r.territory_note && <><br /><span class="muted">{r.territory_note}</span></>}</dd>
            <dt>Alcance</dt><dd>{V.label(V.geographicScopes, r.geographic_scope)}</dd>
            <dt>Período</dt><dd>{r.date_range.label}</dd>
            <dt>Línguas</dt><dd>{r.languages.map((l) => V.label(V.languages, l)).join(', ')}</dd>
            <dt>Tipos de acervo</dt><dd>{r.collection_types.map((t) => V.label(V.collectionTypes, t)).join(', ')}</dd>
            {r.collection_types_original.length > 0 && (<><dt>Termos da fonte</dt><dd lang="und">{r.collection_types_original.join('; ')}</dd></>)}
            <dt>Temas</dt><dd>{r.themes.map((t) => V.label(V.themes, t)).join(', ') || '—'}</dd>
            {r.themes_original.length > 0 && (<><dt>Etiquetas originais</dt><dd lang="und">{r.themes_original.join('; ')}</dd></>)}
            <dt>Formatos</dt><dd>{r.formats.map((f) => V.label(V.formats, f)).join(', ')}</dd>
            {r.design_dimensions.length > 0 && (<><dt>Design</dt><dd>{r.design_dimensions.map((d) => V.label(V.designDimensions, d)).join(', ')}</dd></>)}
          </dl>
        </div>
        <p><a class="btn" href={`/comparar/?ids=${r.id}`}>Comparar com outros</a></p>
      </aside>
    </div>

    {rel.length > 0 && (
      <section aria-labelledby="relacoes" class="relations">
        <h2 id="relacoes">Relações</h2>
        <p class="muted">Vínculos por atributos em comum. Não indicam influência nem relação institucional.</p>
        <ul class="rel-list">
          {rel.map(({ record: o, reasons }) => (
            <li>
              <a href={recordPath(o.id)}><strong>{o.name}</strong></a>
              <span class="meta muted"> — {reasons.join('; ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="historico" class="history">
      <h2 id="historico">Histórico do registro</h2>
      <ol class="meta">
        {r.change_log.map((c) => (
          <li>
            <time datetime={c.date}>{formatDate(c.date)}</time> — {c.field === '*' ? 'registro' : c.field}:
            {c.from != null && <> de “{c.from}”</>}{c.to != null && <> para “{c.to}”</>}. {c.reason}
          </li>
        ))}
      </ol>
      <p class="meta muted">
        Incluído em {formatDate(r.created_at)} · atualizado em {formatDate(r.updated_at)} ·{' '}
        <a href="/contribuir/">corrigir ou contestar esta descrição</a>
      </p>
    </section>
  </article>
</Base>
)}

<style>
  .record-head {
    border-bottom: 2px solid var(--rule);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .lede {
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0;
  }
  .cols {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
    .side {
      position: sticky;
      top: 1rem;
      align-self: start;
    }
  }
  .main > section {
    margin-bottom: 2.5rem;
  }
  .sample {
    border: 2px solid var(--ink);
    padding: 1.2rem 1.4rem;
    background: #fffdf8;
  }
  .open-sample {
    margin-top: 1rem;
  }
  .box {
    border-top: 2px solid var(--rule);
    padding-top: 0.8rem;
    margin-bottom: 1.5rem;
  }
  .fields.compact {
    grid-template-columns: 1fr;
    gap: 0.1rem;
    margin-top: 0.8rem;
  }
  .fields.compact dd {
    margin-bottom: 0.5rem;
  }
  .flag {
    color: var(--red);
    border-left: 3px solid var(--red);
    padding-left: 0.6rem;
  }
  .evidence {
    padding-left: 1.2rem;
  }
  .evidence li {
    margin-bottom: 0.9rem;
  }
  .evidence p {
    margin-bottom: 0.2rem;
  }
  .relations,
  .history {
    border-top: 2px solid var(--rule);
    padding-top: 1rem;
    margin-top: 2rem;
  }
  .rel-list {
    padding-left: 1.2rem;
  }
</style>
